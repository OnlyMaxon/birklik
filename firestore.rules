rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check moderator role
    function isModerator() {
      return request.auth != null && request.auth.token.moderator == true;
    }

    // Helper function to check property ownership
    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }

    // В избранном менялась только отметка самого вошедшего.
    // Проверяются обе стороны: и что добавили не чужой uid, и что убрали не чужой.
    // hasOnly на пустом множестве истинен, поэтому «ничего не изменилось» тоже
    // проходит — это не опасно и избавляет от отказа на повторном клике.
    function togglesOwnFavoriteOnly(before, after) {
      return after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
        && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
    }

    match /users/{userId} {
      // Читать профиль может только он сам и модератор. Публичных полей здесь нет:
      // имя и аватар автора комментария копируются в сам комментарий, а имя и
      // телефон владельца объявления лежат в поле `owner` объявления. Прежний
      // комментарий обещал «Others: only public fields» — правило этого не делало
      // и не делает.
      allow read: if request.auth != null && (
        request.auth.uid == userId || isModerator()
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['moderator', 'admin']);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Писать в ЧУЖУЮ подколлекцию разрешено намеренно: уведомления рассылает
      // клиент — владельцу о брони, гостю об ответе, модераторам о жалобе.
      // Но само уведомление обязано признавать своего адресата: без сверки
      // userId с путём документ мог заявить любого получателя и сбить разбор
      // на клиенте.
      allow create: if request.auth != null
        && request.resource.data.userId == userId
        && request.resource.data.read == false
        && request.resource.data.type is string
        && request.resource.data.message is string;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /properties/{propertyId} {
      allow read: if true;

      // Create: paid-tier metadata is never client-controlled. Paid listings begin
      // as drafts and are activated by the verified Azericard callback.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.isFeatured == false
        && !request.resource.data.keys().hasAny(['premiumExpiresAt', 'vipExpiresAt'])
        && (
          (request.resource.data.listingTier == 'standard'
            && request.resource.data.status == 'pending')
          || (request.resource.data.listingTier in ['vip', 'premium']
            && request.resource.data.status == 'draft')
        );

      // Update: владелец правит своё, модератор — что угодно, любой вошедший —
      // только собственную отметку «в избранном».
      allow update: if request.auth != null && (
        // Owner: paid-tier and moderation fields can only be changed server-side.
        (isOwner(resource.data.ownerId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'createdAt', 'status', 'listingTier', 'premiumExpiresAt', 'vipExpiresAt', 'isFeatured']))
        // Moderator: can update anything including status
        || isModerator()
        // Здесь были ещё views, likes, comments, а отдельной веткой — ratings,
        // rating и reviews. То есть любой аутентифицированный мог переписать весь
        // массив комментариев, накрутить просмотры и выставить оценку на ЧУЖОМ
        // объявлении: проверялся только НАБОР изменённых полей, но не кто и не
        // на чьей записи их меняет.
        //
        // Всё перечисленное давно пишет сервер под сервис-аккаунтом, а его правила
        // не касаются: просмотры — recordPropertyView, комментарии и оценки —
        // серверные экшены страницы объявления. Из браузера остаётся ровно один
        // сценарий, он и разрешён.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favorites'])
          && togglesOwnFavoriteOnly(
               resource.data.get('favorites', []),
               request.resource.data.get('favorites', [])
             ))
      );

      // Delete: owner or moderator
      allow delete: if request.auth != null && (
        isOwner(resource.data.ownerId) || isModerator()
      );
    }

    // Подколлекции properties/{id}/comments в проде нет: комментарии лежат
    // массивом `comments` внутри самого документа объявления, и пишет их сервер.
    // Правила для неё существовали, но не относились ни к чему — код, который
    // ими пользовался (commentsService), не вызывается ниоткуда. Оставлять
    // разрешающее правило на неиспользуемый путь незачем: теперь он закрыт
    // умолчанием. Если комментарии однажды переедут в подколлекцию — правила
    // писать заново, вместе с переездом.

    match /bookings/{bookingId} {
      // Read: any authenticated user (needed for date-conflict checks when creating a booking)
      allow read: if request.auth != null;
      
      // Create: user booking must be created by the authenticated user with 'pending' status
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAny(['propertyId', 'checkInDate', 'checkOutDate', 'totalPrice', 'nights', 'userName', 'userEmail', 'userPhone']);
      
      // Update: authorized users can update with different restrictions based on role
      allow update: if request.auth != null && (
        // Guest can change pending -> cancelled
        (request.auth.uid == resource.data.userId
         && resource.data.status == 'pending'
         && request.resource.data.status == 'cancelled')
        // Гость просит отменить ПОДТВЕРЖДЁННУЮ бронь: approved -> cancellation_requested.
        // Сама отмена остаётся за владельцем, гость только поднимает флаг, поэтому
        // разрешено менять ровно одно поле.
        || (request.auth.uid == resource.data.userId
         && resource.data.status == 'approved'
         && request.resource.data.status == 'cancellation_requested'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Владелец отвечает на запрос отмены: подтверждает (cancelled) либо
        // возвращает бронь в силу (approved).
        || (isOwner(get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.ownerId)
         && resource.data.status == 'cancellation_requested'
         && (request.resource.data.status == 'cancelled' || request.resource.data.status == 'approved')
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Property owner can change pending -> approved or pending -> rejected
        || (isOwner(get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.ownerId)
         && resource.data.status == 'pending'
         && (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected')
         && request.resource.data.keys().hasOnly(['id', 'propertyId', 'userId', 'ownerId', 'userName', 'userEmail', 'userPhone', 'checkInDate', 'checkOutDate', 'nights', 'totalPrice', 'createdAt', 'status', 'approvedAt', 'rejectedAt', 'rejectionReason']))
        // Owner can edit dates for approved bookings (to reschedule)
        || (isOwner(get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.ownerId)
         && resource.data.status == 'approved'
         && request.resource.data.keys().hasOnly(['id', 'propertyId', 'userId', 'ownerId', 'userName', 'userEmail', 'userPhone', 'checkInDate', 'checkOutDate', 'nights', 'totalPrice', 'createdAt', 'status', 'approvedAt', 'rejectedAt', 'rejectionReason']))
      );
      
      // Delete: owner/moderator can delete any booking, or user can delete their own cancelled bookings.
      // isModerator() идёт первым намеренно: следующая ветка читает документ объявления, а у
      // части броней объявление уже удалено — get() вернёт null, обращение к .data оборвёт
      // проверку ошибкой, и до модератора она бы не дошла.
      allow delete: if request.auth != null && (
        isModerator()
        || (request.auth.uid == resource.data.userId && resource.data.status == 'cancelled')
        || isOwner(get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.ownerId)
      );
    }

    match /commentReports/{reportId} {
      // Read: only moderators can read reports (NOT any authenticated user)
      allow read: if request.auth != null && isModerator();
      
      // Create: any authenticated user can report a comment
      allow create: if request.auth != null
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.reportedByName != null
        && request.resource.data.commentId != null
        && request.resource.data.propertyId != null
        && request.resource.data.reason != null;
      
      // Update: moderator can update (close/dismiss reports)
      allow update: if request.auth != null && isModerator();
      
      // Delete: moderator can delete reports
      allow delete: if request.auth != null && isModerator();
    }

    match /cancellationRequests/{requestId} {
      // Read: guest can read their own cancellation requests, or owner can read requests for their properties
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.guestId
        || request.auth.uid == resource.data.ownerId
      );

      // Create: guest must match auth user
      allow create: if request.auth != null
        && request.resource.data.guestId == request.auth.uid
        && request.resource.data.bookingId != null
        && request.resource.data.propertyId != null
        && request.resource.data.ownerId != null
        && request.resource.data.guestName != null
        && request.resource.data.guestEmail != null
        && request.resource.data.checkInDate != null
        && request.resource.data.checkOutDate != null
        && request.resource.data.status == 'pending';

      // Update: only property owner can update status (approve/reject)
      allow update: if request.auth != null
        && isOwner(resource.data.ownerId)
        && (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected')
        && request.resource.data.respondedAt != null;

      // Delete: guest, owner, or moderator can delete
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.guestId
        || request.auth.uid == resource.data.ownerId
        || isModerator()
      );
    }
  }
}
