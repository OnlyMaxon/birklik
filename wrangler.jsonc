{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birklik-az",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-05",
  // nodejs_compat нужен рантайму Next и node:crypto (подпись JWT сервис-аккаунта).
  // global_fetch_strictly_public — рекомендация OpenNext, без него self-fetch
  // воркера уходит мимо публичной сети.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Тестовый поддомен. Взят вместо workers.dev потому, что reCAPTCHA разрешает
  // домен вместе со всеми поддоменами: birklik.az уже в списке ключа, значит
  // App Check здесь работает без правок в Google Cloud Console.
  "workers_dev": true,
  // Оба домена обязаны быть здесь. wrangler приводит привязки воркера к этому
  // списку: если домен добавлен через дашборд, но забыт в конфиге, ближайший
  // deploy его снимет и боевой адрес перестанет отвечать.
  "routes": [
    {"pattern": "birklik.az", "custom_domain": true},
    {"pattern": "next.birklik.az", "custom_domain": true}
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "birklik-65289.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "birklik-65289",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "birklik-65289.firebasestorage.app",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "695765296567",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:695765296567:web:e4864e9226fb279686f432"
  }
}
