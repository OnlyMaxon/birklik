{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birklik-az",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-05",
  // nodejs_compat нужен firebase-admin (node:crypto для подписи session-куки
  // и custom-токенов). global_fetch_strictly_public — рекомендация OpenNext,
  // без него self-fetch воркера уходит мимо публичной сети.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "birklik-65289.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "birklik-65289",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "birklik-65289.firebasestorage.app",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "695765296567",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:695765296567:web:e4864e9226fb279686f432"
  }
}
