{
  "name": "firebase-functions",
  "description": "Cloud Functions for Birklik.az",
  "scripts": {
    "build": "tsc",
    "start": "pnpm build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "cleanup:dry": "ts-node src/cleanup/admin.ts --dry-run",
    "cleanup:execute": "ts-node src/cleanup/admin.ts --execute",
    "storage:audit": "ts-node src/cleanup/storage-orphans.ts",
    "storage:backup": "ts-node src/cleanup/storage-orphans.ts --backup",
    "storage:purge": "ts-node src/cleanup/storage-orphans.ts"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
