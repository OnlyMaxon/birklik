rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /properties/{userId}/{allPaths=**} {
      // Read: anyone
      allow read: if true;
      // Create: only the user who owns the property can upload
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      // Update: only the owner can update
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      // Delete: владелец папки — или модератор, разбирающий объявление.
      //
      // ⚠️ Без модератора удаление работало НАПОЛОВИНУ И МОЛЧА. Крестик у снимка
      // вычёркивает адрес из документа — с сайта фотография пропадает у любого
      // объявления. Следом клиент просит стереть файл, правила отбивают по uid,
      // а отказ проглатывается (`deletePropertyImages` только пишет в журнал).
      // Снимок исчезал из объявления, но оставался в хранилище и был открыт на
      // чтение по прямой ссылке до недельной чистки — а она берёт файлы старше
      // 30 дней. Подпись «фото будет удалено при сохранении» обещала больше,
      // чем делалось.
      //
      // Метка `moderator` в токене уже используется правилами Firestore, своего
      // источника правды здесь не заводится. Серверная функция для этого не
      // нужна: правила хранилища читают тот же токен.
      allow delete: if request.auth != null
        && (request.auth.uid == userId || request.auth.token.moderator == true);
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }
  }
}