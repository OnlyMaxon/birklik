# Firebase Configuration
# Get these values from Firebase Console -> Project Settings -> General -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Cloud Messaging (Push Notifications)
# Get from Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates -> Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_here

# Firebase App Check — reCAPTCHA Enterprise
# Этот проект использует ключ Enterprise, поэтому переменная именно с суффиксом
# _ENTERPRISE_: по ней код выбирает ReCaptchaEnterpriseProvider. Если положить
# тот же ключ под именем NEXT_PUBLIC_RECAPTCHA_SITE_KEY, инициализируется
# ReCaptchaV3Provider, и App Check начнёт выдавать невалидные токены — Firestore
# и Authentication будут молча отбивать запросы клиента.
# Ключ смотреть в Google Cloud Console -> Security -> reCAPTCHA Enterprise.
# Домены, с которых разрешено получать токен, задаются там же, на самом ключе.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=your_enterprise_site_key_here

# Использовать вместо предыдущей, только если ключ создан как обычный reCAPTCHA v3.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here

# Optional local App Check debug token. It must also be registered in Firebase Console.
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=your_registered_debug_token

# CARTO basemaps — ключ на растровые тайлы карты.
# Без него CARTO печатает поверх тайлов «API KEY REQUIRED», и код молча
# откатывается на тайлы OpenStreetMap (см. src/components/map/basemap.ts).
# Бесплатный ключ (5 млн тайлов в месяц) выдают по форме на
# https://carto.com/basemaps/apikey/ — почта, домен, описание проекта.
# ВНИМАНИЕ: значение попадает в бандл на сборке, а не в рантайме, поэтому
# переменная нужна в env-файле во время `pnpm cf:build`.
NEXT_PUBLIC_CARTO_API_KEY=your_carto_key_here

# Firebase Admin SDK (server-only — never prefix these with NEXT_PUBLIC_)
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Paste the "client_email" and "private_key" fields from the downloaded JSON.
# The private key contains literal newlines — keep it quoted with \n escapes, e.g.:
#   FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
