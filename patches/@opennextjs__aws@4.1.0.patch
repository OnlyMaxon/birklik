diff --git a/dist/build/copyTracedFiles.js b/dist/build/copyTracedFiles.js
index 9701b0401e987ee7cd696873af9d15b751580c52..f70f4fce0430e834a1bd67cbc3073f6c2ee41494 100644
--- a/dist/build/copyTracedFiles.js
+++ b/dist/build/copyTracedFiles.js
@@ -228,7 +228,17 @@ File ${serverPath} does not exist
                 symlinkSync(symlink, to);
             }
             catch (e) {
-                if (e.code !== "EEXIST") {
+                if (e.code === "EEXIST") {
+                    // already linked
+                }
+                else if (e.code === "EPERM" && process.platform === "win32") {
+                    // Windows lets an unprivileged process create a junction but not a
+                    // symlink. Next.js links external server packages (firebase-admin)
+                    // as absolute directory paths, which a junction represents exactly,
+                    // so retry as one instead of demanding Developer Mode / admin.
+                    symlinkSync(symlink, to, "junction");
+                }
+                else {
                     throw e;
                 }
             }
